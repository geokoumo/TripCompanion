# Supabase project credentials.
# Find both values in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The app's own canonical URL, used for auth email redirects (password
# reset, signup confirmation). Required in production — set this in
# Vercel's Environment Variables to https://trip-companion-sepia-two.vercel.app
# (origin only, no trailing slash, no path). Leave unset for local
# development: the app falls back to window.location.origin.
VITE_SITE_URL=
